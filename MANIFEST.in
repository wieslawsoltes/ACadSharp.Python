include LICENSE THIRD_PARTY_NOTICES.md README.md pyproject.toml setup.py upstream-versions.json
include .gitmodules mkdocs.yml
recursive-include src *.py *.pyi *.json py.typed
recursive-include scripts *.py
recursive-include tests *.py *.dxf *.dwg
recursive-include docs *.md *.css
recursive-include examples *.py
recursive-include native *.cs *.csproj *.json *.xml *.h *.md
recursive-include packaging *.py *.toml *.md
recursive-include external/ACadSharp *.cs *.csproj *.projitems *.props *.targets *.snk *.resx
include external/ACadSharp/LICENSE external/ACadSharp/README.md
include external/ACadSharp/src/CSUtilities/LICENSE external/ACadSharp/src/CSUtilities/README.md
recursive-exclude external .git .gitignore .gitattributes
prune external/ACadSharp/src/ACadSharp/bin
prune external/ACadSharp/src/ACadSharp/obj
prune src/acadsharp/_managed
global-exclude __pycache__ *.py[cod] .DS_Store
